# A program verified from Peano's axioms with Hoare logic
#
# Proved by the Python block below; Budge checks every
# step, including those of the imported library.
#
# Program: count the odd numbers below $N.
#
#   $I = 0; $S = 0;
#   WHILE (¬EQ($I,$N)) {
#       IF (EQ(MOD2($I),S(0))) { $S = S($S); } ELSE { ; }
#       $I = S($I);
#   }
#
# Goal: {⊤} program {EQ($S,DIV2($N))}, i.e. the count is ⌊N/2⌋.
#
# Program variables $I, $S (assigned) and $N (read-only input) are constants
# of the term language; expressions and conditions are written in the
# library's notation (S, MOD2, EQ, ¬), so conditions can enter assertions
# directly. The Hoare rules are in lib/hoare.btp. MOD2 and DIV2 are defined by
# recursion in lib/parity.btp, which also proves the arithmetic facts the
# verification needs (thDiv2Odd, thDiv2Even); nothing about them is assumed.
#
# Invariant: $S = DIV2($I). The verification conditions are proved
# Hilbert-style under their assumption (e.g. ⊢((Inv∧G)∧C => ...)), taking the
# conjuncts apart with rAndL/rAndR.
#
# Side conditions (not checked by Budge): in rAssignS g must not mention $S,
# in rAssignI a must not mention $I.

<?py load('lib/parity.btp') ?>
<?py load('lib/hoare.btp') ?>
## Program variables: constants, closed terms
rTmVarI : $I
rTmVarS : $S
rTmVarN : $N
rCtVarI : CT($I)

## Assignment, for the assertion shapes this program uses. Q[e/x] is filling
## in e: {EQ(e,g)} for $S (g must not mention $S), {EQ(a,DIV2(e))} for $I
## (a must not mention $I).
rAssignS : {EQ(e,g)} $S = e; {EQ($S,g)}
rAssignI : {EQ(a,DIV2(e))} $I = e; {EQ(a,DIV2($I))}

<?py
import os, sys; sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
from tactics import *
use(env, __file__)

ATOM_RULES.update({'$I': 'rTmVarI', '$S': 'rTmVarS', '$N': 'rTmVarN'})
CT_ATOMS['$I'] = 'rCtVarI'


I, Sv, Nv = '$I', '$S', '$N'
ONE = S(Z)

# Assertions
Inv = EQ(Sv, DIV2(I))                  # $S = ⌊$I/2⌋
G = NOT(EQ(I, Nv))                     # loop guard
C = EQ(MOD2(I), ONE)                   # $I is odd
InvG = AND(Inv, G)
PreThen = EQ(S(Sv), DIV2(S(I)))
Mid = EQ(Sv, DIV2(S(I)))
Post = EQ(Sv, DIV2(Nv))
Init0 = EQ(Z, DIV2(Z))
InitI = EQ(Z, DIV2(I))

# Program
cI0, cS0 = ASG(I, Z), ASG(Sv, Z)
init = SEQ(cI0, cS0)
cSS, cIS = ASG(Sv, S(Sv)), ASG(I, S(I))
ifc = IF(C, cSS, SKIP)
body = SEQ(ifc, cIS)
loop = WHILE(G, body)
prog = SEQ(init, loop)


section('Initialisation', 'HoA', [
    'Backwards from Inv: $S = 0 needs EQ(0,DIV2($I)), $I = 0 needs EQ(0,DIV2(0)),',
    'which is the definition rDiv2Z; K weakens it to ⊤ => EQ(0,DIV2(0)).'])
t1 = apply('rAssignI', [('a', Z), ('e', Z)], [])
t2 = apply('rAssignS', [('e', Z), ('g', DIV2(I))], [])
t3 = apply('rSeq', [('p', Init0), ('a', cI0), ('q', InitI), ('b', cS0), ('r', Inv)], [t1, t2])
vcInit = weaken(sym(apply('rDiv2Z', [], [])), TOP)
tInit = apply('rConsPre', [('p', TOP), ('q', Init0), ('c', init), ('r', Inv)], [vcInit, t3],
              name='thInit')

section('Loop body: odd $I', 'HoB', [
    'VC: (Inv ∧ G) ∧ C => EQ(S($S),DIV2(S($I))):',
    '  S($S) = S(DIV2($I))      (Inv, under the assumption)',
    '        = DIV2(S($I))      (thDiv2Odd at $I, using C)'])
A = AND(InvG, C)
hInv = hs(andl(InvG, C), andl(Inv, G))                # ⊢(A => Inv)
hOdd = hs(andr(InvG, C), inst('thDiv2Odd', I))        # ⊢(A => DIV2(S($I)) = S(DIV2($I)))
vcThen = chain(S(Sv), [([0], hInv), ([], sym(hOdd))])
tA = apply('rAssignS', [('e', S(Sv)), ('g', DIV2(S(I)))], [])
tThen = apply('rConsPre', [('p', A), ('q', PreThen), ('c', cSS), ('r', Mid)], [vcThen, tA])

section('Loop body: even $I', 'HoC', [
    'VC: (Inv ∧ G) ∧ ¬C => EQ($S,DIV2(S($I))):',
    '  $S = DIV2($I) = DIV2(S($I))   (Inv; thDiv2Even at $I, using ¬C)'])
A2 = AND(InvG, NOT(C))
hInv2 = hs(andl(InvG, NOT(C)), andl(Inv, G))
hEven = hs(andr(InvG, NOT(C)), inst('thDiv2Even', I))
vcElse = trans(hInv2, sym(hEven))
tSkip = apply('rSkip', [('p', Mid)], [])
tElse = apply('rConsPre', [('p', A2), ('q', Mid), ('c', SKIP), ('r', Mid)], [vcElse, tSkip])

section('Loop body and loop', 'HoD', [
    'IF combines both branches; $I = S($I) restores Inv from Mid; WHILE gives',
    '{Inv} loop {Inv ∧ ¬G}.'])
tIf = apply('rIf', [('p', InvG), ('b', C), ('c', cSS), ('d', SKIP), ('q', Mid)], [tThen, tElse])
tI = apply('rAssignI', [('a', Sv), ('e', S(I))], [])
tBody = apply('rSeq', [('p', InvG), ('a', ifc), ('q', Mid), ('b', cIS), ('r', Inv)], [tIf, tI],
              name='thBody')
tLoop = apply('rWhile', [('p', Inv), ('b', G), ('c', body)], [tBody])

section('Loop exit and the whole program', 'HoE', [
    'VC: Inv ∧ ¬¬EQ($I,$N) => EQ($S,DIV2($N)): double negation elimination',
    '(thDNE) gives $I = $N, congruence of DIV2 gives DIV2($I) = DIV2($N).'])
E = EQ(I, Nv)
A3 = AND(Inv, NOT(G))
hE = hs(andr(Inv, NOT(G)), apply('thDNE', [('i', E)], []))
hH = hs(hE, apply('rCongDiv2', [('x', I), ('y', Nv)], []))
vcExit = trans(andl(Inv, NOT(G)), hH)
tLoopPost = apply('rConsPost', [('p', Inv), ('c', loop), ('q', A3), ('r', Post)],
                  [tLoop, vcExit], name='thLoop')
apply('rSeq', [('p', TOP), ('a', init), ('q', Inv), ('b', loop), ('r', Post)],
      [tInit, tLoopPost], name='thProgram')
prose('pProgram', 'The program sets $S to DIV2($N) = ⌊$N/2⌋, the number of odd numbers below $N.')
?>

## Extraction: hoare.py, generated from the checked value of thProgram (lib/extract.py)
<?py
from extract import write_py
write_py(env, 'thProgram', 'count_odd_below', 'hoare.py', __file__)
?>
