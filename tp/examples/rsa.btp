# Toy RSA public-key cryptography: encrypt with the public key, decrypt with
# the private key.
#
# Key generation: p=2, q=5, so n=pq=10 and phi(n)=(p-1)(q-1)=4.
# Public exponent e=3, private exponent d=7, since d*e=21 = 1 (mod 4).
# Public key: (e,n) = (3,10).  Private key: (d,n) = (7,10).
#
# Encrypt m=7: c = 7^3 mod 10 = 343 mod 10 = 3
# Decrypt c=3: m = 3^7 mod 10 = 2187 mod 10 = 7
#
# Numbers are written as tallies (3 = |||). Adding two tallies is just
# writing them side by side, so `zx` in a rule means z+x.
# All statements are of the form `... MOD n` and mean "congruent modulo n".

<?py load('lib/tally.btp') ?>
# Tally numbers and modular multiplication and powers come from lib/tally.btp.

# Encryption uses the public key (e,n), decryption the private key (d,n)
rEncrypt : m^e=c MOD n -> ENCRYPT m WITH PUBLIC KEY (e,n) = c
rDecrypt : c^d=m MOD n -> DECRYPT c WITH PRIVATE KEY (d,n) = m

# Multiplication lemmas (mod 10)

# 7*7 = 49 = 9 (mod 10); along the way 7*3 = 21 = 1 (mod 10)
thA1!  : rMulOne  x=tmBar7!;n=tmBar10!                          # 7*1 = 7
thA2!  : rMulSucc x=tmBar7!;y=tmBar1!;z=tmBar7!;n=tmBar10! thA1!      # 7*2 = 14
thA2r! : rMulRed  x=tmBar7!;y=tmBar2!;z=tmBar4!;n=tmBar10! thA2!      #     = 4
thA3!  : rMulSucc x=tmBar7!;y=tmBar2!;z=tmBar4!;n=tmBar10! thA2r!     # 7*3 = 11
thA3r! : rMulRed  x=tmBar7!;y=tmBar3!;z=tmBar1!;n=tmBar10! thA3!      #     = 1
thA4!  : rMulSucc x=tmBar7!;y=tmBar3!;z=tmBar1!;n=tmBar10! thA3r!     # 7*4 = 8
thA5!  : rMulSucc x=tmBar7!;y=tmBar4!;z=tmBar8!;n=tmBar10! thA4!      # 7*5 = 15
thA5r! : rMulRed  x=tmBar7!;y=tmBar5!;z=tmBar5!;n=tmBar10! thA5!      #     = 5
thA6!  : rMulSucc x=tmBar7!;y=tmBar5!;z=tmBar5!;n=tmBar10! thA5r!     # 7*6 = 12
thA6r! : rMulRed  x=tmBar7!;y=tmBar6!;z=tmBar2!;n=tmBar10! thA6!      #     = 2
thA7!  : rMulSucc x=tmBar7!;y=tmBar6!;z=tmBar2!;n=tmBar10! thA6r!     # 7*7 = 9

# 9*7 = 63 = 3 (mod 10); along the way 9*3 = 27 = 7 (mod 10)
thB1!  : rMulOne  x=tmBar9!;n=tmBar10!                          # 9*1 = 9
thB2!  : rMulSucc x=tmBar9!;y=tmBar1!;z=tmBar9!;n=tmBar10! thB1!      # 9*2 = 18
thB2r! : rMulRed  x=tmBar9!;y=tmBar2!;z=tmBar8!;n=tmBar10! thB2!      #     = 8
thB3!  : rMulSucc x=tmBar9!;y=tmBar2!;z=tmBar8!;n=tmBar10! thB2r!     # 9*3 = 17
thB3r! : rMulRed  x=tmBar9!;y=tmBar3!;z=tmBar7!;n=tmBar10! thB3!      #     = 7
thB4!  : rMulSucc x=tmBar9!;y=tmBar3!;z=tmBar7!;n=tmBar10! thB3r!     # 9*4 = 16
thB4r! : rMulRed  x=tmBar9!;y=tmBar4!;z=tmBar6!;n=tmBar10! thB4!      #     = 6
thB5!  : rMulSucc x=tmBar9!;y=tmBar4!;z=tmBar6!;n=tmBar10! thB4r!     # 9*5 = 15
thB5r! : rMulRed  x=tmBar9!;y=tmBar5!;z=tmBar5!;n=tmBar10! thB5!      #     = 5
thB6!  : rMulSucc x=tmBar9!;y=tmBar5!;z=tmBar5!;n=tmBar10! thB5r!     # 9*6 = 14
thB6r! : rMulRed  x=tmBar9!;y=tmBar6!;z=tmBar4!;n=tmBar10! thB6!      #     = 4
thB7!  : rMulSucc x=tmBar9!;y=tmBar6!;z=tmBar4!;n=tmBar10! thB6r!     # 9*7 = 13
thB7r! : rMulRed  x=tmBar9!;y=tmBar7!;z=tmBar3!;n=tmBar10! thB7!      #     = 3

# 3*3 = 9 (mod 10)
thC1!  : rMulOne  x=tmBar3!;n=tmBar10!                          # 3*1 = 3
thC2!  : rMulSucc x=tmBar3!;y=tmBar1!;z=tmBar3!;n=tmBar10! thC1!      # 3*2 = 6
thC3!  : rMulSucc x=tmBar3!;y=tmBar2!;z=tmBar6!;n=tmBar10! thC2!      # 3*3 = 9

# 1*3 = 3 (mod 10)
thD1!  : rMulOne  x=tmBar1!;n=tmBar10!                          # 1*1 = 1
thD2!  : rMulSucc x=tmBar1!;y=tmBar1!;z=tmBar1!;n=tmBar10! thD1!      # 1*2 = 2
thD3!  : rMulSucc x=tmBar1!;y=tmBar2!;z=tmBar2!;n=tmBar10! thD2!      # 1*3 = 3

# Proofs

# Key check: d*e = 7*3 = 21 = 1 (mod phi(n) = 4)
pKeys  : Key check: d*e = 7*3 = 1 (mod 4)
thK1!  : rMulOne  x=tmBar7!;n=tmBar4!                           # 7*1 = 7
thK1r! : rMulRed  x=tmBar7!;y=tmBar1!;z=tmBar3!;n=tmBar4! thK1!       #     = 3
thK2!  : rMulSucc x=tmBar7!;y=tmBar1!;z=tmBar3!;n=tmBar4! thK1r!      # 7*2 = 10
thK2r! : rMulRed  x=tmBar7!;y=tmBar2!;z=tmBar6!;n=tmBar4! thK2!       #     = 6
thK2s! : rMulRed  x=tmBar7!;y=tmBar2!;z=tmBar2!;n=tmBar4! thK2r!      #     = 2
thK3!  : rMulSucc x=tmBar7!;y=tmBar2!;z=tmBar2!;n=tmBar4! thK2s!      # 7*3 = 9
thK3r! : rMulRed  x=tmBar7!;y=tmBar3!;z=tmBar5!;n=tmBar4! thK3!       #     = 5
thKeys : rMulRed  x=tmBar7!;y=tmBar3!;z=tmBar1!;n=tmBar4! thK3r!      #     = 1

# Example 1: Encrypt m=7 with public key (3,10) -> c=3
pEnc      : Encrypt m=7 with public key (e=3, n=10): 7^3 = 343 = 3 (mod 10)
thEnc1    : rPowOne  x=tmBar7!;n=tmBar10!                                       # 7^1 = 7
thEnc2    : rPowSucc b=tmBar7!;k=tmBar1!;a=tmBar7!;c=tmBar9!;n=tmBar10! thEnc1 thA7!     # 7^2 = 9
thEnc3    : rPowSucc b=tmBar7!;k=tmBar2!;a=tmBar9!;c=tmBar3!;n=tmBar10! thEnc2 thB7r!    # 7^3 = 3
thEncrypt : rEncrypt m=tmBar7!;e=tmBar3!;c=tmBar3!;n=tmBar10! thEnc3

# Example 2: Decrypt c=3 with private key (7,10) -> m=7
pDec      : Decrypt c=3 with private key (d=7, n=10): 3^7 = 2187 = 7 (mod 10)
thDec1    : rPowOne  x=tmBar3!;n=tmBar10!                                       # 3^1 = 3
thDec2    : rPowSucc b=tmBar3!;k=tmBar1!;a=tmBar3!;c=tmBar9!;n=tmBar10! thDec1 thC3!     # 3^2 = 9
thDec3    : rPowSucc b=tmBar3!;k=tmBar2!;a=tmBar9!;c=tmBar7!;n=tmBar10! thDec2 thB3r!    # 3^3 = 7
thDec4    : rPowSucc b=tmBar3!;k=tmBar3!;a=tmBar7!;c=tmBar1!;n=tmBar10! thDec3 thA3r!    # 3^4 = 1
thDec5    : rPowSucc b=tmBar3!;k=tmBar4!;a=tmBar1!;c=tmBar3!;n=tmBar10! thDec4 thD3!     # 3^5 = 3
thDec6    : rPowSucc b=tmBar3!;k=tmBar5!;a=tmBar3!;c=tmBar9!;n=tmBar10! thDec5 thC3!     # 3^6 = 9
thDec7    : rPowSucc b=tmBar3!;k=tmBar6!;a=tmBar9!;c=tmBar7!;n=tmBar10! thDec6 thB3r!    # 3^7 = 7
thDecrypt : rDecrypt c=tmBar3!;d=tmBar7!;m=tmBar7!;n=tmBar10! thDec7
