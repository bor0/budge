# Terms vs. typed theorems
#
# The terms 0, S(x) and NIL come from the library (lib/fol.btp, lib/list.btp)
# and can be combined freely. N(x), "x is a natural number", is a theorem,
# derivable only for 0 and successors of natural numbers.

<?py load('lib/list.btp') ?>
## Numbers
# Zero is a natural number
rThmZ : N(0)
thmZ! : rThmZ

# The successor of a natural number is a natural number
rThmS : N(x) -> N(S(x))

## Example

# Compared e.g. to `list.btp`, here we can construct `S(NIL)` (term)
termNil : rTmS x=tmNil!
# But we cannot construct N(S(NIL)) (theorem), since `rThmS x=tmNil!` requires N(NIL) which is not derivable

term1 : rTmS x=tm0!
theorem1 : rThmS x=tm0! thmZ!
