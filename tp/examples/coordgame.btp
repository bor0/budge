# Numbers

<?py load('lib/peano.btp') ?>
# Initial game state
rCoordOrigin : P(0,0) E(S(S(0)),S(0)) HP=S(S(0))

# Game commands (attack)
rGameAttack : P(x,y) E(x,y) HP=S(h) -> P(x,y) E(x,y) HP=h
rGameFinalAttack : P(x,y) E(x,y) HP=0 -> WIN

# Game commands (movement)
rCoordA : P(S(x),y) E(a,b) HP=h -> P(x,y) E(a,b) HP=h
rCoordD : P(x,y) E(a,b) HP=h -> P(S(x),y) E(a,b) HP=h
rCoordW : P(x,S(y)) E(a,b) HP=h -> P(x,y) E(a,b) HP=h
rCoordS : P(x,y) E(a,b) HP=h -> P(x,S(y)) E(a,b) HP=h


# Gameplay
thGameStart : rCoordOrigin
thGameMoveRight1 : rCoordD x=tm0!;y=tm0!;a=tm2!;b=tm1!;h=tm2! thGameStart
thGameMoveRight2 : rCoordD x=tm1!;y=tm0!;a=tm2!;b=tm1!;h=tm2! thGameMoveRight1
thGameMoveUp : rCoordS x=tm2!;y=tm0!;a=tm2!;b=tm1!;h=tm2! thGameMoveRight2
thGameAttack1 : rGameAttack x=tm2!;y=tm1!;h=tm1! thGameMoveUp
thGameAttack2 : rGameAttack x=tm2!;y=tm1!;h=tm0! thGameAttack1
thGameWin : rGameFinalAttack x=tm2!;y=tm1! thGameAttack2
