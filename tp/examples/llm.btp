# The simplest possible "LLM": a bigram language model.
#
# An LLM is trained to predict the next token from the previous ones, and then
# generates text by repeatedly appending its prediction. Here the context is
# just ONE token (a bigram model, the n=2 ancestor of GPT), the "weights" are
# bigram counts learned from a tiny corpus, and decoding is either greedy
# (always pick the most probable next token, i.e. temperature 0) or sampled
# (pick by a roll of the dice, i.e. temperature 1).
#
# Pipeline, all as derivations:
#   1. Corpus   : one axiom, consumed token by token from the left
#   2. Tokenize : read every adjacent pair (bigram) out of the corpus
#   3. Train    : count each bigram with tally numbers (|| = 2), and turn the
#                 counts into probabilities PROB(w,v) = COUNT(w,v) / TOTAL(w)
#   4. Weights  : PREDICT(w)=v when v is the most probable successor of w
#   5. Generate : append PREDICT(last token) until the end token `.`, and
#                 score the reply with the chain rule: P(reply) is the product
#                 of PROB over every generated token
#   6. Sample   : same, but each token is PICKed by a roll from 1 to TOTAL
#
# Because the model only sees one token of context, it happily stitches
# sentences together at shared words, producing text that is NOT in the corpus.
#
# Only the corpus axiom (tagged DATA) can be tokenized, so prompts and
# generated text can never leak into training.
#
# Caveats (things Budge cannot enforce, the prover must be honest about):
#   - rMore can count the same observation twice
#   - rTotal/rTotalAdd don't check each successor is added exactly once (a
#     partial TOTAL gives a wrong PROB, e.g. PROB(THE,CAT)=||/||)
#   - rArgmax/rCertain don't check that every competing successor was considered
#   - rPickSecond assumes v and u are the only successors, in that order
#   - rolls are supplied by hand, so "random" is up to the prover

<?py load('lib/tally.btp') ?>
# Rules

# Tokens (the vocabulary) and concatenation
rTmTHE    : THE
rTmA      : A
rTmQUEEN  : QUEEN
rTmCAT    : CAT
rTmDOG    : DOG
rTmEATS   : EATS
rTmCHASES : CHASES
rTmCAKE   : CAKE
rTmFISH   : FISH
rTmDOT    : .

# Training data
rCorpus : DATA THE QUEEN EATS CAKE . THE CAT EATS FISH . A CAT EATS FISH . A DOG CHASES THE CAT .
rShift  : DATA w s -> DATA s

# Tokenizer: data starting with `w v` contains the bigram w->v
rRead    : DATA w v s -> OBS w v
rReadEnd : DATA w v -> OBS w v

# Training: count bigram observations (tallies, so n| is n+1)
rFirst : OBS w v -> COUNT(w,v)=|
rMore  : COUNT(w,v)=n -> OBS w v -> COUNT(w,v)=n|

# Probabilities: COUNT(w,v) / sum of COUNT(w,_) over all successors
rTotal    : COUNT(w,v)=n -> TOTAL(w)=n
rTotalAdd : TOTAL(w)=n -> COUNT(w,v)=m -> TOTAL(w)=nm      # tallies: nm is n+m
rProb     : COUNT(w,v)=n -> TOTAL(w)=t -> PROB(w,v)=n/t

# Weights: the predicted next token is the most probable successor
rArgmax  : PROB(w,v)=nm/t -> PROB(w,u)=n/t -> PREDICT(w)=v  # v strictly more likely than u
rCertain : PROB(w,v)=n/n -> PREDICT(w)=v                    # v has probability 1

# Probability arithmetic: fractions, and unevaluated products of them
rTmFrac : n/t
rTmMul  : x·y

# Greedy decoding: append the prediction for the last token. Text and its
# probability so far are separated by @, and a prompt has probability 1
rStart : s w -> s w @ |/|
rGen   : s w @ x -> PROB(w,v)=y -> PREDICT(w)=v -> s w v @ x·y

# Sampling: a roll r from 1 to TOTAL(w) lands on one successor's tickets.
# With PROB(w,v)=n/t and PROB(w,u)=m/t, v owns tickets 1..n and u owns n+1..n+m
rPickFirst  : PROB(w,v)=n/t -> r≤n -> PICK(w,r)=v
rPickSecond : PROB(w,v)=n/t -> PROB(w,u)=m/t -> nk≤nm -> PICK(w,nk)=u
rSample     : s w @ x -> PROB(w,v)=y -> PICK(w,r)=v -> s w v @ x·y

# Terms

tmTHE!    : rTmTHE
tmA!      : rTmA
tmQUEEN!  : rTmQUEEN
tmCAT!    : rTmCAT
tmDOG!    : rTmDOG
tmEATS!   : rTmEATS
tmCHASES! : rTmCHASES
tmCAKE!   : rTmCAKE
tmFISH!   : rTmFISH
tmDOT!    : rTmDOT
tmP1_1!   : rTmFrac n=tmBar1!;t=tmBar1!
tmP2_2!   : rTmFrac n=tmBar2!;t=tmBar2!
tmP1_3!   : rTmFrac n=tmBar1!;t=tmBar3!
tmP2_3!   : rTmFrac n=tmBar2!;t=tmBar3!

# 1. Corpus

# Suffixes of the corpus (built right to left), used to name `s` in rShift/rRead
tmC20!   : rTmSeq x=tmCAT!;y=tmDOT!
tmC19!   : rTmSeq x=tmTHE!;y=tmC20!
tmC18!   : rTmSeq x=tmCHASES!;y=tmC19!
tmC17!   : rTmSeq x=tmDOG!;y=tmC18!
tmC16!   : rTmSeq x=tmA!;y=tmC17!
tmC15!   : rTmSeq x=tmDOT!;y=tmC16!
tmC14!   : rTmSeq x=tmFISH!;y=tmC15!
tmC13!   : rTmSeq x=tmEATS!;y=tmC14!
tmC12!   : rTmSeq x=tmCAT!;y=tmC13!
tmC11!   : rTmSeq x=tmA!;y=tmC12!
tmC10!   : rTmSeq x=tmDOT!;y=tmC11!
tmC9!    : rTmSeq x=tmFISH!;y=tmC10!
tmC8!    : rTmSeq x=tmEATS!;y=tmC9!
tmC7!    : rTmSeq x=tmCAT!;y=tmC8!
tmC6!    : rTmSeq x=tmTHE!;y=tmC7!
tmC5!    : rTmSeq x=tmDOT!;y=tmC6!
tmC4!    : rTmSeq x=tmCAKE!;y=tmC5!
tmC3!    : rTmSeq x=tmEATS!;y=tmC4!
tmC2!    : rTmSeq x=tmQUEEN!;y=tmC3!

thCorpus : rCorpus

# Consume the corpus from the left, one token at a time
thD2!  : rShift w=tmTHE!;s=tmC2!            thCorpus
thD3!  : rShift w=tmQUEEN!;s=tmC3!          thD2!
thD4!  : rShift w=tmEATS!;s=tmC4!           thD3!
thD5!  : rShift w=tmCAKE!;s=tmC5!           thD4!
thD6!  : rShift w=tmDOT!;s=tmC6!            thD5!
thD7!  : rShift w=tmTHE!;s=tmC7!            thD6!
thD8!  : rShift w=tmCAT!;s=tmC8!            thD7!
thD9!  : rShift w=tmEATS!;s=tmC9!           thD8!
thD10! : rShift w=tmFISH!;s=tmC10!          thD9!
thD11! : rShift w=tmDOT!;s=tmC11!           thD10!
thD12! : rShift w=tmA!;s=tmC12!             thD11!
thD13! : rShift w=tmCAT!;s=tmC13!           thD12!
thD14! : rShift w=tmEATS!;s=tmC14!          thD13!
thD15! : rShift w=tmFISH!;s=tmC15!          thD14!
thD16! : rShift w=tmDOT!;s=tmC16!           thD15!
thD17! : rShift w=tmA!;s=tmC17!             thD16!
thD18! : rShift w=tmDOG!;s=tmC18!           thD17!
thD19! : rShift w=tmCHASES!;s=tmC19!        thD18!
thD20! : rShift w=tmTHE!;s=tmC20!           thD19!

# 2. Tokenize into bigrams

thO1!  : rRead w=tmTHE!;v=tmQUEEN!;s=tmC3!           thCorpus  # THE QUEEN
thO2!  : rRead w=tmQUEEN!;v=tmEATS!;s=tmC4!          thD2!     # QUEEN EATS
thO3!  : rRead w=tmEATS!;v=tmCAKE!;s=tmC5!           thD3!     # EATS CAKE
thO4!  : rRead w=tmCAKE!;v=tmDOT!;s=tmC6!            thD4!     # CAKE .
thO5!  : rRead w=tmDOT!;v=tmTHE!;s=tmC7!             thD5!     # . THE
thO6!  : rRead w=tmTHE!;v=tmCAT!;s=tmC8!             thD6!     # THE CAT
thO7!  : rRead w=tmCAT!;v=tmEATS!;s=tmC9!            thD7!     # CAT EATS
thO8!  : rRead w=tmEATS!;v=tmFISH!;s=tmC10!          thD8!     # EATS FISH
thO9!  : rRead w=tmFISH!;v=tmDOT!;s=tmC11!           thD9!     # FISH .
thO10! : rRead w=tmDOT!;v=tmA!;s=tmC12!              thD10!    # . A
thO11! : rRead w=tmA!;v=tmCAT!;s=tmC13!              thD11!    # A CAT
thO12! : rRead w=tmCAT!;v=tmEATS!;s=tmC14!           thD12!    # CAT EATS
thO13! : rRead w=tmEATS!;v=tmFISH!;s=tmC15!          thD13!    # EATS FISH
thO14! : rRead w=tmFISH!;v=tmDOT!;s=tmC16!           thD14!    # FISH .
thO15! : rRead w=tmDOT!;v=tmA!;s=tmC17!              thD15!    # . A
thO16! : rRead w=tmA!;v=tmDOG!;s=tmC18!              thD16!    # A DOG
thO17! : rRead w=tmDOG!;v=tmCHASES!;s=tmC19!         thD17!    # DOG CHASES
thO18! : rRead w=tmCHASES!;v=tmTHE!;s=tmC20!         thD18!    # CHASES THE
thO19! : rRead w=tmTHE!;v=tmCAT!;s=tmDOT!            thD19!    # THE CAT
thO20! : rReadEnd w=tmCAT!;v=tmDOT!                 thD20!    # CAT .

# 3. Train: count the bigrams we need

thTHE_QUEEN    : rFirst w=tmTHE!;v=tmQUEEN! thO1!
thTHE_CAT1!    : rFirst w=tmTHE!;v=tmCAT! thO6!
thTHE_CAT      : rMore  w=tmTHE!;v=tmCAT!;n=tmBar1! thTHE_CAT1! thO19!
thQUEEN_EATS   : rFirst w=tmQUEEN!;v=tmEATS! thO2!
thEATS_CAKE    : rFirst w=tmEATS!;v=tmCAKE! thO3!
thCAKE_DOT     : rFirst w=tmCAKE!;v=tmDOT! thO4!
thEATS_FISH1!  : rFirst w=tmEATS!;v=tmFISH! thO8!
thEATS_FISH    : rMore  w=tmEATS!;v=tmFISH!;n=tmBar1! thEATS_FISH1! thO13!
thCAT_EATS1!   : rFirst w=tmCAT!;v=tmEATS! thO7!
thCAT_EATS     : rMore  w=tmCAT!;v=tmEATS!;n=tmBar1! thCAT_EATS1! thO12!
thCAT_DOT      : rFirst w=tmCAT!;v=tmDOT! thO20!
thFISH_DOT1!   : rFirst w=tmFISH!;v=tmDOT! thO9!
thFISH_DOT     : rMore  w=tmFISH!;v=tmDOT!;n=tmBar1! thFISH_DOT1! thO14!
thDOG_CHASES   : rFirst w=tmDOG!;v=tmCHASES! thO17!
thCHASES_THE   : rFirst w=tmCHASES!;v=tmTHE! thO18!

# 3b. Probabilities

thTotalTHE1!   : rTotal    w=tmTHE!;v=tmCAT!;n=tmBar2! thTHE_CAT
thTotalTHE!    : rTotalAdd w=tmTHE!;v=tmQUEEN!;n=tmBar2!;m=tmBar1! thTotalTHE1! thTHE_QUEEN
thTotalEATS1!  : rTotal    w=tmEATS!;v=tmFISH!;n=tmBar2! thEATS_FISH
thTotalEATS!   : rTotalAdd w=tmEATS!;v=tmCAKE!;n=tmBar2!;m=tmBar1! thTotalEATS1! thEATS_CAKE
thTotalCAT1!   : rTotal    w=tmCAT!;v=tmEATS!;n=tmBar2! thCAT_EATS
thTotalCAT!    : rTotalAdd w=tmCAT!;v=tmDOT!;n=tmBar2!;m=tmBar1! thTotalCAT1! thCAT_DOT
thTotalQUEEN!  : rTotal    w=tmQUEEN!;v=tmEATS!;n=tmBar1! thQUEEN_EATS
thTotalFISH!   : rTotal    w=tmFISH!;v=tmDOT!;n=tmBar2! thFISH_DOT
thTotalDOG!    : rTotal    w=tmDOG!;v=tmCHASES!;n=tmBar1! thDOG_CHASES
thTotalCHASES! : rTotal    w=tmCHASES!;v=tmTHE!;n=tmBar1! thCHASES_THE
thTotalCAKE!   : rTotal    w=tmCAKE!;v=tmDOT!;n=tmBar1! thCAKE_DOT

pProbs            : Next-token probabilities (tally fractions, ||/||| = 2/3)
thProbTHE_CAT     : rProb w=tmTHE!;v=tmCAT!;n=tmBar2!;t=tmBar3!     thTHE_CAT    thTotalTHE!
thProbTHE_QUEEN   : rProb w=tmTHE!;v=tmQUEEN!;n=tmBar1!;t=tmBar3!   thTHE_QUEEN  thTotalTHE!
thProbEATS_FISH   : rProb w=tmEATS!;v=tmFISH!;n=tmBar2!;t=tmBar3!   thEATS_FISH  thTotalEATS!
thProbEATS_CAKE   : rProb w=tmEATS!;v=tmCAKE!;n=tmBar1!;t=tmBar3!   thEATS_CAKE  thTotalEATS!
thProbCAT_EATS    : rProb w=tmCAT!;v=tmEATS!;n=tmBar2!;t=tmBar3!    thCAT_EATS   thTotalCAT!
thProbCAT_DOT     : rProb w=tmCAT!;v=tmDOT!;n=tmBar1!;t=tmBar3!     thCAT_DOT    thTotalCAT!
thProbQUEEN_EATS  : rProb w=tmQUEEN!;v=tmEATS!;n=tmBar1!;t=tmBar1!    thQUEEN_EATS thTotalQUEEN!
thProbFISH_DOT    : rProb w=tmFISH!;v=tmDOT!;n=tmBar2!;t=tmBar2!      thFISH_DOT   thTotalFISH!
thProbDOG_CHASES  : rProb w=tmDOG!;v=tmCHASES!;n=tmBar1!;t=tmBar1!    thDOG_CHASES thTotalDOG!
thProbCHASES_THE  : rProb w=tmCHASES!;v=tmTHE!;n=tmBar1!;t=tmBar1!    thCHASES_THE thTotalCHASES!
thProbCAKE_DOT    : rProb w=tmCAKE!;v=tmDOT!;n=tmBar1!;t=tmBar1!      thCAKE_DOT   thTotalCAKE!

# 4. Weights: most probable next token for each context

pWeights         : Learned weights (greedy next-token table)
thPredictTHE     : rArgmax  w=tmTHE!;v=tmCAT!;u=tmQUEEN!;n=tmBar1!;m=tmBar1!;t=tmBar3! thProbTHE_CAT thProbTHE_QUEEN
thPredictEATS    : rArgmax  w=tmEATS!;v=tmFISH!;u=tmCAKE!;n=tmBar1!;m=tmBar1!;t=tmBar3! thProbEATS_FISH thProbEATS_CAKE
thPredictCAT     : rArgmax  w=tmCAT!;v=tmEATS!;u=tmDOT!;n=tmBar1!;m=tmBar1!;t=tmBar3! thProbCAT_EATS thProbCAT_DOT
thPredictQUEEN   : rCertain w=tmQUEEN!;v=tmEATS!;n=tmBar1! thProbQUEEN_EATS
thPredictFISH    : rCertain w=tmFISH!;v=tmDOT!;n=tmBar2! thProbFISH_DOT
thPredictDOG     : rCertain w=tmDOG!;v=tmCHASES!;n=tmBar1! thProbDOG_CHASES
thPredictCHASES  : rCertain w=tmCHASES!;v=tmTHE!;n=tmBar1! thProbCHASES_THE

# 5. Generate greedily, scoring each reply with the chain rule
#    (tmXs! = text so far, tmXx! = probability so far)

# The queen only ever ate cake in the corpus, but EATS -> FISH outvotes it
pPrompt1 : Prompt: THE QUEEN (greedy)
tmP1!    : rTmSeq x=tmTHE!;y=tmQUEEN!
thG0!    : rStart s=tmTHE!;w=tmQUEEN! tmP1!
thG1!    : rGen s=tmTHE!;w=tmQUEEN!;v=tmEATS!;x=tmP1_1!;y=tmP1_1! thG0! thProbQUEEN_EATS thPredictQUEEN
tmGx1!   : rTmMul x=tmP1_1!;y=tmP1_1!
thG2!    : rGen s=tmP1!;w=tmEATS!;v=tmFISH!;x=tmGx1!;y=tmP2_3! thG1! thProbEATS_FISH thPredictEATS
tmGs2!   : rTmSeq x=tmP1!;y=tmEATS!
tmGx2!   : rTmMul x=tmGx1!;y=tmP2_3!
thReply1 : rGen s=tmGs2!;w=tmFISH!;v=tmDOT!;x=tmGx2!;y=tmP2_2! thG2! thProbFISH_DOT thPredictFISH

# The dog chases the cat, and then the cat's sentence takes over
pPrompt2 : Prompt: A DOG (greedy)
tmP2!    : rTmSeq x=tmA!;y=tmDOG!
thH0!    : rStart s=tmA!;w=tmDOG! tmP2!
thH1!    : rGen s=tmA!;w=tmDOG!;v=tmCHASES!;x=tmP1_1!;y=tmP1_1! thH0! thProbDOG_CHASES thPredictDOG
tmHx1!   : rTmMul x=tmP1_1!;y=tmP1_1!
thH2!    : rGen s=tmP2!;w=tmCHASES!;v=tmTHE!;x=tmHx1!;y=tmP1_1! thH1! thProbCHASES_THE thPredictCHASES
tmHs2!   : rTmSeq x=tmP2!;y=tmCHASES!
tmHx2!   : rTmMul x=tmHx1!;y=tmP1_1!
thH3!    : rGen s=tmHs2!;w=tmTHE!;v=tmCAT!;x=tmHx2!;y=tmP2_3! thH2! thProbTHE_CAT thPredictTHE
tmHs3!   : rTmSeq x=tmHs2!;y=tmTHE!
tmHx3!   : rTmMul x=tmHx2!;y=tmP2_3!
thH4!    : rGen s=tmHs3!;w=tmCAT!;v=tmEATS!;x=tmHx3!;y=tmP2_3! thH3! thProbCAT_EATS thPredictCAT
tmHs4!   : rTmSeq x=tmHs3!;y=tmCAT!
tmHx4!   : rTmMul x=tmHx3!;y=tmP2_3!
thH5!    : rGen s=tmHs4!;w=tmEATS!;v=tmFISH!;x=tmHx4!;y=tmP2_3! thH4! thProbEATS_FISH thPredictEATS
tmHs5!   : rTmSeq x=tmHs4!;y=tmEATS!
tmHx5!   : rTmMul x=tmHx4!;y=tmP2_3!
thReply2 : rGen s=tmHs5!;w=tmFISH!;v=tmDOT!;x=tmHx5!;y=tmP2_2! thH5! thProbFISH_DOT thPredictFISH

# 6. Sample: same prompt as reply 1, but with rolls | then ||| then |.
#    Roll ||| after EATS lands on CAKE's ticket (FISH owns 1..2, CAKE owns 3)

pPrompt3    : Prompt: THE QUEEN (sampled, rolls 1, 3, 1)
thLe1!      : rLeEq x=tmBar1!
thLe3!      : rLeEq x=tmBar3!
thPickQUEEN : rPickFirst  w=tmQUEEN!;v=tmEATS!;n=tmBar1!;t=tmBar1!;r=tmBar1! thProbQUEEN_EATS thLe1!
thPickEATS  : rPickSecond w=tmEATS!;v=tmFISH!;u=tmCAKE!;n=tmBar2!;m=tmBar1!;t=tmBar3!;k=tmBar1! thProbEATS_FISH thProbEATS_CAKE thLe3!
thPickCAKE  : rPickFirst  w=tmCAKE!;v=tmDOT!;n=tmBar1!;t=tmBar1!;r=tmBar1! thProbCAKE_DOT thLe1!
thS0!       : rStart s=tmTHE!;w=tmQUEEN! tmP1!
thS1!       : rSample s=tmTHE!;w=tmQUEEN!;v=tmEATS!;x=tmP1_1!;y=tmP1_1!;r=tmBar1! thS0! thProbQUEEN_EATS thPickQUEEN
thS2!       : rSample s=tmP1!;w=tmEATS!;v=tmCAKE!;x=tmGx1!;y=tmP1_3!;r=tmBar3! thS1! thProbEATS_CAKE thPickEATS
tmSx2!      : rTmMul x=tmGx1!;y=tmP1_3!
thReply3    : rSample s=tmGs2!;w=tmCAKE!;v=tmDOT!;x=tmSx2!;y=tmP1_1!;r=tmBar1! thS2! thProbCAKE_DOT thPickCAKE
