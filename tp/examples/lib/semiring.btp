# The natural numbers form a commutative semiring
#
# Proved by the Python block below; Budge checks every
# step. From the defining equations of + and × in peano.btp, proves for all
# natural numbers k, m, n:
#
#   thZeroAdd   0 + n = n                 thZeroMul   0 · n = 0
#   thSuccAdd   S(m) + n = S(m + n)       thSuccMul   S(m) · n = m · n + n
#   thAddComm   m + n = n + m             thMulComm   m · n = n · m
#   thAddAssoc  (k + m) + n = k + (m + n) thDistrib   k · (m + n) = k · m + k · n
#                                         thMulAssoc  (k · m) · n = k · (m · n)
#
# Each is a closed sentence, e.g. thAddComm is
#   ⊢ALL(ALL(EQ(ADD(V(S(0)),V(0)),ADD(V(0),V(S(0))))))
# and every use of a lemma goes through ∀-elimination (rAllE with an OPEN
# derivation). None of these follow by computation, since the definitions only
# recurse on the second argument: each is an induction, and most use earlier
# ones. Several-variable lemmas are proved by induction on the last variable
# with the others as parameters (K, M), then generalised (rGen).
#
# Every equation step is an instance of an equality axiom discharged by modus
# ponens. An induction step assumes P(N) in a Ctx (tactics.py, over nd.btp) and
# discharges it, giving the theorem ⊢(P(N)=>P(S(N))) that rInd needs.

<?py load('peano.btp') ?>
<?py load('nd.btp') ?>
<?py
import os, sys; sys.path.insert(0, os.path.dirname(__file__))
from tactics import *
use(env, __file__)

root = Ctx(reserved={K_, M_, N_})

# ---- 1. 0 + n = n
section('Lemma: 0 + n = n', 'SrA', ['Induction on n. Step: 0+S(N) = S(0+N) = S(N).'])
f = EQ(ADD(Z, V0), V0)
c = root.assume(instantiate(f, N_))
step = c.chain(ADD(Z, S(N_)), [
    ([], aAS(Z, N_)),
    ([0], c.hyp_()),
])
L1 = induction(f, aAZ(Z), root.close(c.discharge(step)), name='thZeroAdd')

# ---- 2. S(m) + n = S(m + n)
section('Lemma: S(m) + n = S(m + n)', 'SrB', [
    'Induction on n, m a parameter M.',
    'Base: S(M)+0 = S(M) = S(M+0).',
    'Step: S(M)+S(N) = S(S(M)+N) = S(S(M+N)) = S(M+S(N)).'])
f = EQ(ADD(S(M_), V0), S(ADD(M_, V0)))
base = chain(ADD(S(M_), Z), [
    ([], aAZ(S(M_))),
    ([0], lambda t: sym(aAZ(M_))),
])
c = root.assume(instantiate(f, N_))
step = c.chain(ADD(S(M_), S(N_)), [
    ([], aAS(S(M_), N_)),
    ([0], c.hyp_()),
    ([0], lambda t: sym(aAS(M_, N_))),
])
L2 = gen(induction(f, base, root.close(c.discharge(step))), M_, name='thSuccAdd')

# ---- 3. m + n = n + m
section('Lemma: m + n = n + m (commutativity of +)', 'SrC', [
    'Induction on n. Base: M+0 = M = 0+M (thZeroAdd).',
    'Step: M+S(N) = S(M+N) = S(N+M) = S(N)+M (thSuccAdd).'])
f = EQ(ADD(M_, V0), ADD(V0, M_))
base = chain(ADD(M_, Z), [
    ([], aAZ(M_)),
    ([], lambda t: sym(inst(L1, M_))),
])
c = root.assume(instantiate(f, N_))
step = c.chain(ADD(M_, S(N_)), [
    ([], aAS(M_, N_)),
    ([0], c.hyp_()),
    ([], lambda t: sym(inst(L2, N_, M_))),
])
L3 = gen(induction(f, base, root.close(c.discharge(step))), M_, name='thAddComm')

# ---- 4. (k + m) + n = k + (m + n)
section('Lemma: (k + m) + n = k + (m + n) (associativity of +)', 'SrD', [
    'Induction on n, k and m parameters K, M.',
    'Step: (K+M)+S(N) = S((K+M)+N) = S(K+(M+N)) = K+S(M+N) = K+(M+S(N)).'])
f = EQ(ADD(ADD(K_, M_), V0), ADD(K_, ADD(M_, V0)))
base = chain(ADD(ADD(K_, M_), Z), [
    ([], aAZ(ADD(K_, M_))),
    ([1], lambda t: sym(aAZ(M_))),
])
c = root.assume(instantiate(f, N_))
step = c.chain(ADD(ADD(K_, M_), S(N_)), [
    ([], aAS(ADD(K_, M_), N_)),
    ([0], c.hyp_()),
    ([], lambda t: sym(aAS(K_, ADD(M_, N_)))),
    ([1], lambda t: sym(aAS(M_, N_))),
])
L4 = gen(gen(induction(f, base, root.close(c.discharge(step))), M_), K_, name='thAddAssoc')

# ---- 5. 0 · n = 0
section('Lemma: 0 · n = 0', 'SrE', ['Induction on n. Step: 0·S(N) = 0·N+0 = 0·N = 0.'])
f = EQ(MUL(Z, V0), Z)
c = root.assume(instantiate(f, N_))
step = c.chain(MUL(Z, S(N_)), [
    ([], aMS(Z, N_)),
    ([], lambda t: aAZ(MUL(Z, N_))),
    ([], c.hyp_()),
])
L5 = induction(f, aMZ(Z), root.close(c.discharge(step)), name='thZeroMul')

# ---- 6. S(m) · n = m · n + n
section('Lemma: S(m) · n = m · n + n', 'SrF', [
    'Induction on n. Step:',
    'S(M)·S(N) = S(M)·N + S(M) = (M·N + N) + S(M) = M·N + (N + S(M))',
    '          = M·N + S(N + M) = M·N + S(M + N) = M·N + (M + S(N))',
    '          = (M·N + M) + S(N) = M·S(N) + S(N)'])
f = EQ(MUL(S(M_), V0), ADD(MUL(M_, V0), V0))
base = chain(MUL(S(M_), Z), [
    ([], aMZ(S(M_))),
    ([], lambda t: sym(trans(aAZ(MUL(M_, Z)), aMZ(M_)))),
])
c = root.assume(instantiate(f, N_))
MN = MUL(M_, N_)
step = c.chain(MUL(S(M_), S(N_)), [
    ([], aMS(S(M_), N_)),
    ([0], c.hyp_()),
    ([], lambda t: inst(L4, MN, N_, S(M_))),
    ([1], lambda t: aAS(N_, M_)),
    ([1, 0], lambda t: inst(L3, N_, M_)),
    ([1], lambda t: sym(aAS(M_, N_))),
    ([], lambda t: sym(inst(L4, MN, M_, S(N_)))),
    ([0], lambda t: sym(aMS(M_, N_))),
])
L6 = gen(induction(f, base, root.close(c.discharge(step))), M_, name='thSuccMul')

# ---- 7. m · n = n · m
section('Lemma: m · n = n · m (commutativity of ·)', 'SrG', [
    'Induction on n. Base: M·0 = 0 = 0·M (thZeroMul).',
    'Step: M·S(N) = M·N + M = N·M + M = S(N)·M (thSuccMul).'])
f = EQ(MUL(M_, V0), MUL(V0, M_))
base = chain(MUL(M_, Z), [
    ([], aMZ(M_)),
    ([], lambda t: sym(inst(L5, M_))),
])
c = root.assume(instantiate(f, N_))
step = c.chain(MUL(M_, S(N_)), [
    ([], aMS(M_, N_)),
    ([0], c.hyp_()),
    ([], lambda t: sym(inst(L6, N_, M_))),
])
L7 = gen(induction(f, base, root.close(c.discharge(step))), M_, name='thMulComm')

# ---- 8. k · (m + n) = k · m + k · n
section('Lemma: k · (m + n) = k · m + k · n (distributivity)', 'SrH', [
    'Induction on n. Step:',
    'K·(M+S(N)) = K·S(M+N) = K·(M+N) + K = (K·M + K·N) + K',
    '           = K·M + (K·N + K) = K·M + K·S(N)'])
f = EQ(MUL(K_, ADD(M_, V0)), ADD(MUL(K_, M_), MUL(K_, V0)))
base = chain(MUL(K_, ADD(M_, Z)), [
    ([1], lambda t: aAZ(M_)),
    ([], lambda t: sym(aAZ(MUL(K_, M_)))),
    ([1], lambda t: sym(aMZ(K_))),
])
c = root.assume(instantiate(f, N_))
step = c.chain(MUL(K_, ADD(M_, S(N_))), [
    ([1], lambda t: aAS(M_, N_)),
    ([], lambda t: aMS(K_, ADD(M_, N_))),
    ([0], c.hyp_()),
    ([], lambda t: inst(L4, MUL(K_, M_), MUL(K_, N_), K_)),
    ([1], lambda t: sym(aMS(K_, N_))),
])
L8 = gen(gen(induction(f, base, root.close(c.discharge(step))), M_), K_, name='thDistrib')

# ---- 9. (k · m) · n = k · (m · n)
section('Lemma: (k · m) · n = k · (m · n) (associativity of ·)', 'SrI', [
    'Induction on n. Base: (K·M)·0 = 0 = K·0 = K·(M·0).',
    'Step: (K·M)·S(N) = (K·M)·N + K·M = K·(M·N) + K·M = K·(M·N + M)',
    '                 = K·(M·S(N))   (thDistrib)'])
f = EQ(MUL(MUL(K_, M_), V0), MUL(K_, MUL(M_, V0)))
base = chain(MUL(MUL(K_, M_), Z), [
    ([], aMZ(MUL(K_, M_))),
    ([], lambda t: sym(aMZ(K_))),
    ([1], lambda t: sym(aMZ(M_))),
])
c = root.assume(instantiate(f, N_))
step = c.chain(MUL(MUL(K_, M_), S(N_)), [
    ([], aMS(MUL(K_, M_), N_)),
    ([0], c.hyp_()),
    ([], lambda t: sym(inst(L8, K_, MUL(M_, N_), M_))),
    ([1], lambda t: sym(aMS(M_, N_))),
])
L9 = gen(gen(induction(f, base, root.close(c.discharge(step))), M_), K_, name='thMulAssoc')
?>
