# Parity: n mod 2 and n div 2 (= ⌊n/2⌋)
#
# Proved by the Python block below; Budge checks every
# step. Defines, by recursion on the successor:
#
#   FLIP(0) = 1, FLIP(1) = 0                     swap 0 and 1
#   MOD2(0) = 0, MOD2(S(n)) = FLIP(MOD2(n))      n mod 2
#   DIV2(0) = 0, DIV2(S(n)) = DIV2(n) + MOD2(n)  ⌊n/2⌋: grows after each odd n
#
# and proves, for all n:
#
#   thModDich   MOD2(n) = 0  ∨  MOD2(n) = 1                     (induction)
#   thDiv2Odd   MOD2(n) = 1  =>  DIV2(S(n)) = S(DIV2(n))
#   thDiv2Even  ¬(MOD2(n) = 1)  =>  DIV2(S(n)) = DIV2(n)        (via thModDich)
#   thDiv2SS    DIV2(S(S(n))) = S(DIV2(n))
#   thDiv2Add   DIV2(n + (m+m)) = DIV2(n) + m                   (induction on m)
#   thDiv2Le    DIV2(n) ≤ n, i.e. ∃j. n = DIV2(n) + j          (induction)

<?py load('semiring.btp') ?>
<?py load('nd.btp') ?>
## Definitions
rFlip0 : ⊢EQ(FLIP(0),S(0))
rFlip1 : ⊢EQ(FLIP(S(0)),0)
rMod0  : ⊢EQ(MOD2(0),0)
rModS  : ⊢EQ(MOD2(S(x)),FLIP(MOD2(x)))
rDiv2Z : ⊢EQ(DIV2(0),0)
rDiv2S : ⊢EQ(DIV2(S(x)),ADD(DIV2(x),MOD2(x)))

## Congruence
rCongFlip : ⊢(EQ(x,y)=>EQ(FLIP(x),FLIP(y)))
rCongMod2 : ⊢(EQ(x,y)=>EQ(MOD2(x),MOD2(y)))
rCongDiv2 : ⊢(EQ(x,y)=>EQ(DIV2(x),DIV2(y)))

## Syntax (see fol.btp)
rTmFlip   : FLIP(x)
rTmMod2   : MOD2(x)
rTmDiv2   : DIV2(x)
rCtFlip   : CT(x) -> CT(FLIP(x))
rCtMod2   : CT(x) -> CT(MOD2(x))
rCtDiv2   : CT(x) -> CT(DIV2(x))
rOpenFlip : OPEN(k,x,t,u) -> OPEN(k,FLIP(x),t,FLIP(u))
rOpenMod2 : OPEN(k,x,t,u) -> OPEN(k,MOD2(x),t,MOD2(u))
rOpenDiv2 : OPEN(k,x,t,u) -> OPEN(k,DIV2(x),t,DIV2(u))
rAbsFlip  : ABS(k,w,x,u) -> ABS(k,w,FLIP(x),FLIP(u))
rAbsMod2  : ABS(k,w,x,u) -> ABS(k,w,MOD2(x),MOD2(u))
rAbsDiv2  : ABS(k,w,x,u) -> ABS(k,w,DIV2(x),DIV2(u))

<?py
import os, sys; sys.path.insert(0, os.path.dirname(__file__))
from tactics import *
use(env, __file__)


root = Ctx(reserved={M_, N_})

# ---- MOD2(n) is 0 or 1
section('Lemma: MOD2(n) = 0 ∨ MOD2(n) = 1', 'PtA', [
    'Induction on n. Base: MOD2(0) = 0. Step, by cases on MOD2(N):',
    '  MOD2(N) = 0  =>  MOD2(S(N)) = FLIP(MOD2(N)) = FLIP(0) = 1',
    '  MOD2(N) = 1  =>  MOD2(S(N)) = FLIP(MOD2(N)) = FLIP(1) = 0'])
f = OR(EQ(MOD2(V0), Z), EQ(MOD2(V0), ONE))
base = root.close(root.or_l(ax('rMod0'), EQ(MOD2(Z), ONE)))
H = instantiate(f, S(N_))


def flip(rule, side):
    def go(c):                                      # MOD2(N) = 0 (or 1) here
        h = c.chain(MOD2(S(N_)), [([], ax('rModS', N_)), ([0], c.hyp_()), ([], ax(rule))])
        return c.or_r(h, H[1]) if side else c.or_l(h, H[2])
    return go


c = root.assume(instantiate(f, N_))
step = root.close(c.discharge(c.cases(c.hyp_(), flip('rFlip0', 1), flip('rFlip1', 0))))
Dich = induction(f, base, step, name='thModDich')

# ---- odd: DIV2(S(n)) = S(DIV2(n))
section('Lemma: MOD2(n) = 1 => DIV2(S(n)) = S(DIV2(n))', 'PtB', [
    'For a parameter M: DIV2(S(M)) = DIV2(M) + MOD2(M) = DIV2(M) + 1',
    '  = S(DIV2(M) + 0) = S(DIV2(M)), then generalise M.'])
C = EQ(MOD2(M_), ONE)
c = root.assume(C)
odd = c.chain(DIV2(S(M_)), [
    ([], ax('rDiv2S', M_)),
    ([1], c.hyp_()),
    ([], aAS(DIV2(M_), Z)),
    ([0], aAZ(DIV2(M_))),
])
Odd = gen(root.close(c.discharge(odd)), M_, name='thDiv2Odd')

# ---- even: DIV2(S(n)) = DIV2(n)
section('Lemma: ¬(MOD2(n) = 1) => DIV2(S(n)) = DIV2(n)', 'PtC', [
    'For a parameter M: thModDich gives MOD2(M) = 0 ∨ MOD2(M) = 1, so under',
    '¬(MOD2(M) = 1) disjunctive syllogism (thDS) gives MOD2(M) = 0, and',
    'DIV2(S(M)) = DIV2(M) + MOD2(M) = DIV2(M) + 0 = DIV2(M). Generalise M.'])
E0M = EQ(MOD2(M_), Z)
c = root.assume(NOT(C))
hE0 = c.mp(inst(Dich, M_), c.thru(c.hyp_(), apply('thDS', [('i', E0M), ('j', C)], [])))
even = c.chain(DIV2(S(M_)), [
    ([], ax('rDiv2S', M_)),
    ([1], hE0),
    ([], aAZ(DIV2(M_))),
])
Even = gen(root.close(c.discharge(even)), M_, name='thDiv2Even')

section('Lemma: DIV2(S(S(n))) = S(DIV2(n))', 'PtD', [
    'DIV2(S(S(n))) = DIV2(n) + MOD2(n) + FLIP(MOD2(n)), and by thModDich one of',
    'MOD2(n), FLIP(MOD2(n)) is 0 and the other 1.'])
root = Ctx(reserved={M_})


def div2ss(flip, other):
    def go(c):                                      # MOD2(M) = 0 (or 1) here
        start = [([], ax('rDiv2S', S(M_))), ([0], ax('rDiv2S', M_)), ([1], ax('rModS', M_)),
                 ([0, 1], c.hyp_()), ([1, 0], c.hyp_()), ([1], ax(flip))]
        return c.chain(DIV2(S(S(M_))), start + other)
    return go


D = DIV2(M_)
h = root.cases(root.get(inst('thModDich', M_)),
               div2ss('rFlip0', [([0], aAZ(D)), ([], aAS(D, Z)), ([0], aAZ(D))]),
               div2ss('rFlip1', [([], aAZ(ADD(D, ONE))), ([], aAS(D, Z)), ([0], aAZ(D))]))
Div2SS = lemma('thDiv2SS', closed(EQ(DIV2(S(S(M_))), S(D)), M_), gen(root.close(h), M_))

section('Lemma: DIV2(n + (m+m)) = DIV2(n) + m', 'PtE', [
    'Induction on m. Step: n + (S(m)+S(m)) = S(S(n + (m+m))), so by thDiv2SS and the',
    'hypothesis DIV2 of it is S(DIV2(n) + m) = DIV2(n) + S(m).'])
stmt = lambda m: EQ(DIV2(ADD(K_, ADD(m, m))), ADD(DIV2(K_), m))
f = abstract(stmt(N_), N_)
root = Ctx(reserved={K_, N_})
base = chain(DIV2(ADD(K_, ADD(Z, Z))), [([0, 1], aAZ(Z)), ([0], aAZ(K_)), ([], sym(aAZ(DIV2(K_))))])
c = root.assume(instantiate(f, N_))
h = c.chain(DIV2(ADD(K_, ADD(S(N_), S(N_)))), [
    ([0, 1], aAS(S(N_), N_)),
    ([0, 1, 0], inst('thSuccAdd', N_, N_)),
    ([0], aAS(K_, S(ADD(N_, N_)))),
    ([0, 0], aAS(K_, ADD(N_, N_))),
    ([], inst(Div2SS, ADD(K_, ADD(N_, N_)))),
    ([0], c.hyp_()),
    ([], sym(aAS(DIV2(K_), N_))),
])
Div2Add = lemma('thDiv2Add', closed(stmt(N_), K_, N_),
                gen(induction(f, base, root.close(c.discharge(h))), K_))

section('Lemma: DIV2(n) ≤ n', 'PtF', [
    'Induction on n. Step from n = DIV2(n) + j: DIV2(S(n)) = DIV2(n) + MOD2(n), so',
    'S(n) = DIV2(S(n)) + S(j) if MOD2(n) = 0 and S(n) = DIV2(S(n)) + j if it is 1.'])
f = abstract(le(DIV2(N_), N_), N_)
root = Ctx(reserved={N_})
h0 = chain(ADD(DIV2(Z), Z), [([], aAZ(DIV2(Z))), ([], ax('rDiv2Z'))])
base = root.close(root.ex_i(root.get(sym(h0)), le(DIV2(Z), Z)[1], Z))
c1 = root.assume(instantiate(f, N_))
goal = le(DIV2(S(N_)), S(N_))


def with_j(c2, j):
    hj = c2.hyp_()                                  # N = DIV2(N) + j
    DN = DIV2(N_)

    def even(c3):                                   # S(N) = DIV2(N)+S(j) = DIV2(S(N))+S(j)
        hd = c3.chain(DIV2(S(N_)), [([], ax('rDiv2S', N_)), ([1], c3.hyp_()), ([], aAZ(DN))])
        h = c3.chain(S(N_), [([0], hj), ([], sym(aAS(DN, j))), ([0], c3.sym(hd))])
        return c3.ex_i(h, goal[1], S(j))

    def odd(c3):                                    # S(N) = S(DIV2(N))+j = DIV2(S(N))+j
        hd = c3.chain(DIV2(S(N_)), [([], ax('rDiv2S', N_)), ([1], c3.hyp_()), ([], aAS(DN, Z)),
                                    ([0], aAZ(DN))])
        h = c3.chain(S(N_), [([0], hj), ([], sym(inst('thSuccAdd', DN, j))), ([0], c3.sym(hd))])
        return c3.ex_i(h, goal[1], j)
    return c2.cases(c2.get(inst('thModDich', N_)), even, odd)


step = root.close(c1.discharge(c1.ex_e(c1.hyp_(), with_j)))
Div2Le = lemma('thDiv2Le', ALL(f), induction(f, base, step))
?>
