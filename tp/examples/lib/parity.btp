# Parity: n mod 2 and n div 2 (= ⌊n/2⌋)
#
# Proved by the Python block below; Budge checks every
# step. Defines, by recursion on the successor:
#
#   FLIP(0) = 1, FLIP(1) = 0                     swap 0 and 1
#   MOD2(0) = 0, MOD2(S(n)) = FLIP(MOD2(n))      n mod 2
#   DIV2(0) = 0, DIV2(S(n)) = DIV2(n) + MOD2(n)  ⌊n/2⌋: grows after each odd n
#
# and proves, for all n:
#
#   thModDich   MOD2(n) = 0  ∨  MOD2(n) = 1                     (induction)
#   thDiv2Odd   MOD2(n) = 1  =>  DIV2(S(n)) = S(DIV2(n))
#   thDiv2Even  ¬(MOD2(n) = 1)  =>  DIV2(S(n)) = DIV2(n)        (via thModDich)

<?py load('peano.btp') ?>
## Definitions
rFlip0 : ⊢EQ(FLIP(0),S(0))
rFlip1 : ⊢EQ(FLIP(S(0)),0)
rMod0  : ⊢EQ(MOD2(0),0)
rModS  : ⊢EQ(MOD2(S(x)),FLIP(MOD2(x)))
rDiv2Z : ⊢EQ(DIV2(0),0)
rDiv2S : ⊢EQ(DIV2(S(x)),ADD(DIV2(x),MOD2(x)))

## Congruence
rCongFlip : ⊢(EQ(x,y)=>EQ(FLIP(x),FLIP(y)))
rCongMod2 : ⊢(EQ(x,y)=>EQ(MOD2(x),MOD2(y)))
rCongDiv2 : ⊢(EQ(x,y)=>EQ(DIV2(x),DIV2(y)))

## Syntax (see fol.btp)
rTmFlip   : FLIP(x)
rTmMod2   : MOD2(x)
rTmDiv2   : DIV2(x)
rCtFlip   : CT(x) -> CT(FLIP(x))
rCtMod2   : CT(x) -> CT(MOD2(x))
rCtDiv2   : CT(x) -> CT(DIV2(x))
rOpenFlip : OPEN(k,x,t,u) -> OPEN(k,FLIP(x),t,FLIP(u))
rOpenMod2 : OPEN(k,x,t,u) -> OPEN(k,MOD2(x),t,MOD2(u))
rOpenDiv2 : OPEN(k,x,t,u) -> OPEN(k,DIV2(x),t,DIV2(u))
rAbsFlip  : ABS(k,w,x,u) -> ABS(k,w,FLIP(x),FLIP(u))
rAbsMod2  : ABS(k,w,x,u) -> ABS(k,w,MOD2(x),MOD2(u))
rAbsDiv2  : ABS(k,w,x,u) -> ABS(k,w,DIV2(x),DIV2(u))

<?py
import os, sys; sys.path.insert(0, os.path.dirname(__file__))
from tactics import *
use(env, __file__)


ONE = S(Z)


# ---- MOD2(n) is 0 or 1
section('Lemma: MOD2(n) = 0 ∨ MOD2(n) = 1', 'PtA', [
    'Induction on n. Base: MOD2(0) = 0. Step, by cases on MOD2(N):',
    '  MOD2(N) = 0  =>  MOD2(S(N)) = FLIP(MOD2(N)) = FLIP(0) = 1',
    '  MOD2(N) = 1  =>  MOD2(S(N)) = FLIP(MOD2(N)) = FLIP(1) = 0'])
f = OR(EQ(MOD2(V0), Z), EQ(MOD2(V0), ONE))
b0 = ax('rMod0')
base = mp(b0, apply('rOrL', [('p', EQ(MOD2(Z), Z)), ('q', EQ(MOD2(Z), ONE))], []))
H = subst(f, V0, S(N_))
E0, E1 = EQ(MOD2(N_), Z), EQ(MOD2(N_), ONE)
case0 = chain(MOD2(S(N_)), [
    ([], ax('rModS', N_)),
    ([0], apply('thId', [('i', E0)], [])),
    ([], ax('rFlip0')),
])                                                  # ⊢(E0 => MOD2(S(N)) = 1)
case0 = hs(case0, apply('rOrR', [('p', H[1]), ('q', H[2])], []))
case1 = chain(MOD2(S(N_)), [
    ([], ax('rModS', N_)),
    ([0], apply('thId', [('i', E1)], [])),
    ([], ax('rFlip1')),
])                                                  # ⊢(E1 => MOD2(S(N)) = 0)
case1 = hs(case1, apply('rOrL', [('p', H[1]), ('q', H[2])], []))
Dich = induction(f, base, or_elim(case0, case1, H), name='thModDich')

# ---- odd: DIV2(S(n)) = S(DIV2(n))
section('Lemma: MOD2(n) = 1 => DIV2(S(n)) = S(DIV2(n))', 'PtB', [
    'For a parameter M: DIV2(S(M)) = DIV2(M) + MOD2(M) = DIV2(M) + 1',
    '  = S(DIV2(M) + 0) = S(DIV2(M)), then generalise M.'])
C = EQ(MOD2(M_), ONE)
odd = chain(DIV2(S(M_)), [
    ([], ax('rDiv2S', M_)),
    ([1], apply('thId', [('i', C)], [])),
    ([], aAS(DIV2(M_), Z)),
    ([0], aAZ(DIV2(M_))),
])
Odd = gen(odd, M_, name='thDiv2Odd')

# ---- even: DIV2(S(n)) = DIV2(n)
section('Lemma: ¬(MOD2(n) = 1) => DIV2(S(n)) = DIV2(n)', 'PtC', [
    'For a parameter M: thModDich gives MOD2(M) = 0 ∨ MOD2(M) = 1, so under',
    '¬(MOD2(M) = 1) disjunctive syllogism (thDS) gives MOD2(M) = 0, and',
    'DIV2(S(M)) = DIV2(M) + MOD2(M) = DIV2(M) + 0 = DIV2(M). Generalise M.'])
NC, E0M = NOT(C), EQ(MOD2(M_), Z)
dM = inst(Dich, M_)                                  # ⊢(E0M ∨ C)
ds = apply('thDS', [('i', E0M), ('j', C)], [])       # ⊢(¬C => ((E0M ∨ C) => E0M))
s_ = apply('rS', [('p', NC), ('q', OR(E0M, C)), ('r', E0M)], [])
hE0 = mp(weaken(dM, NC), mp(ds, s_))                 # ⊢(¬C => E0M)
even = chain(DIV2(S(M_)), [
    ([], ax('rDiv2S', M_)),
    ([1], hE0),
    ([], aAZ(DIV2(M_))),
])
Even = gen(even, M_, name='thDiv2Even')
?>
